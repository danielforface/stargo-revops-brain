# The backend reads OS environment variables; this file is documentation only.
# Do not commit a populated .env or provider credentials.
# Import Stargo_RevOps_Take_Home_Pack_v2.zip locally with scripts/import_take_home.py.
STARGO_DATA_DIR=./data/private
STARGO_DB_PATH=./runtime/revops.sqlite3

# Default, fully functional reviewer mode: no LLM key or external API required.
STARGO_LLM_PROVIDER=rules-only

# Gemini Live: the user enters a key in the localhost React UI (session-only).
# No GEMINI_API_KEY is required or stored on disk.
# Models offered by the UI: gemini-3.5-flash-lite, gemini-3.8-flash,
# and legacy gemini-2.5-flash-lite / gemini-2.5-flash where accessible.

# Optional existing alternative Agent A provider, explicitly opt-in:
# STARGO_LLM_PROVIDER=groq
# GROQ_API_KEY=replace-locally-never-commit
# GROQ_MODEL=llama-3.1-8b-instant
