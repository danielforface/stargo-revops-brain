# Path to the data/ directory of the original take-home pack (not committed)
STARGO_DATA_DIR=./data/private
STARGO_DB_PATH=./runtime/revops.sqlite3
# rules-only is an offline, deterministic labelled fallback
STARGO_LLM_PROVIDER=rules-only
# Optional live extractor via fixed Groq endpoint; uses free-tier account if available
# STARGO_LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Gemini Live is enabled by an operator-entered API key in the browser UI.
# No persistent GEMINI_API_KEY is required or read by this local demo.
# Models: gemini-2.5-flash / gemini-2.5-flash-lite
